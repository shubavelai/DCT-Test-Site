{"components/common/requireness-msg":"<small>\r\n    {{#if required}}\r\n    <span class=\"require-astric\">*</span>\r\n    {{else}}\r\n    {{lang 'common.optional'}}\r\n    {{/if}}\r\n</small>\r\n","components/products/options/input-checkbox":"<div class=\"form-field\" data-product-attribute=\"input-checkbox\">\n    <label class=\"form-label form-label--alternate form-label--inlineSmall\">\n        {{display_name}}:\n\n        {{> components/common/requireness-msg}}\n    </label>\n    <input type=\"hidden\" name=\"attribute[{{id}}]\" value=\"{{noValue}}\" />\n    <div class=\"form-option-wrapper\">\n        <label for=\"attribute-check-{{id}}\" class=\"u-hiddenVisually\"></label>\n        <input\n            class=\"form-checkbox\"\n            type=\"checkbox\"\n            name=\"attribute[{{id}}]\"\n            id=\"attribute-check-{{id}}\"\n            value=\"{{value}}\"\n            {{#if checked}}\n                checked\n                data-default\n            {{/if}}\n            {{#if required}}required{{/if}}>\n\n        <label class=\"form-label {{class}}\" for=\"attribute-check-{{id}}\">{{label}}</label>\n    </div>\n</div>\n"}
