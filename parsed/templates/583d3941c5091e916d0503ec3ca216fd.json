{"components/common/paginator":"<nav class=\"pagination\" aria-label=\"pagination\">\n    <ul class=\"pagination-list\">\n        {{#if previous}}\n            <li class=\"pagination-item pagination-item--previous\">\n                <a class=\"pagination-link\"\n                   href=\"{{previous}}\"\n                   {{#unless reload}}data-faceted-search-facet{{/unless}}\n                   aria-label=\"{{lang 'common.previous'}}\"\n                >\n                    <i class=\"icon\" aria-hidden=\"true\">\n                        <svg>\n                            <use href=\"#icon-chevron-left\"></use>\n                        </svg>\n                    </i>\n                    {{lang 'common.previous'}}\n                </a>\n            </li>\n        {{/if}}\n        {{#each links}}\n            <li class=\"pagination-item {{#if this.number '==' ../current}}pagination-item--current{{/if}}\">\n                <a class=\"pagination-link\"\n                   href=\"{{this.url}}\"\n                   {{#unless reload}}data-faceted-search-facet{{/unless}}\n                   {{#if this.number '==' ../current}}\n                   aria-current=\"page\"\n                   data-pagination-current-page-link\n                   {{/if}}\n                   aria-label=\"{{lang 'common.paginator.page_of' current=this.number total=../links.length}}\"\n                >\n                    {{this.number}}\n                </a>\n            </li>\n        {{/each}}\n\n        {{#if next}}\n            <li class=\"pagination-item pagination-item--next\">\n                <a class=\"pagination-link\"\n                   href=\"{{next}}\"\n                   {{#unless reload}}data-faceted-search-facet{{/unless}}\n                   aria-label=\"{{lang 'common.next'}}\"\n                >\n                    {{lang 'common.next'}}\n                    <i class=\"icon\" aria-hidden=\"true\">\n                        <svg>\n                            <use href=\"#icon-chevron-right\"></use>\n                        </svg>\n                    </i>\n                </a>\n            </li>\n        {{/if}}\n    </ul>\n</nav>\n","components/products/description-tabs":"<div class=\"accordions-tabs-wrapper\">\r\n    \r\n    <div class=\"tabs-nav\">\r\n        {{#if product.description}}\r\n        <label for=\"tab-desc\" class=\"tab-btn\" id=\"label-desc\">Description</label>\r\n        {{/if}}\r\n        \r\n        {{#if product.videos.list.length}}\r\n            <label for=\"tab-videos\" class=\"tab-btn\" id=\"label-videos\">Product Videos</label>\r\n        {{/if}}\r\n\r\n        {{#if product.warranty}}\r\n        <label for=\"tab-warranty\" class=\"tab-btn\" id=\"label-warranty\">Certificates & Catalogs</label>\r\n        {{/if}}\r\n        \r\n        {{#all settings.show_product_reviews theme_settings.show_product_reviews product.reviews.total}}\r\n        <label for=\"tab-reviews\" class=\"tab-btn\" id=\"label-reviews\">{{lang 'products.reviews.header' total=product.reviews.total}}</label>\r\n        {{/all}}\r\n    </div>\r\n\r\n    \r\n    <div class=\"tabs-content-container\">\r\n        {{#if product.description}}\r\n        <input type=\"radio\" name=\"product-tabs\" id=\"tab-desc\" checked>\r\n        <div class=\"tab-panel\" id=\"panel-desc\">\r\n            <div id=\"full-description-content\">\r\n                {{{product.description}}}\r\n            </div>\r\n        </div>\r\n        {{/if}}\r\n\r\n        {{#if product.warranty}}\r\n        <input type=\"radio\" name=\"product-tabs\" id=\"tab-warranty\">\r\n        <div class=\"tab-panel\" id=\"panel-warranty\">\r\n            <p>{{{product.warranty}}}</p>\r\n        </div>\r\n        {{/if}}\r\n\r\n        {{#if product.videos.list.length}}\r\n        <input type=\"radio\" name=\"product-tabs\" id=\"tab-videos\">\r\n        <div class=\"tab-panel\" id=\"panel-videos\">\r\n            \r\n           {{> components/products/videos product.videos}}\r\n        </div>\r\n        {{/if}}\r\n\r\n        {{#all settings.show_product_reviews theme_settings.show_product_reviews product.reviews.total}}\r\n        <input type=\"radio\" name=\"product-tabs\" id=\"tab-reviews\">\r\n        <div class=\"tab-panel\" id=\"panel-reviews\">\r\n            <dl class=\"productView-info productReviewTab\">\r\n                {{> components/products/reviews reviews=product.reviews product=product urls=urls}}\r\n            </dl>\r\n        </div>\r\n        {{/all}}\r\n    </div>\r\n</div>\r\n\r\n<script>\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const descContainer = document.getElementById('full-description-content');\r\n    \r\n    if (descContainer) {\r\n        let htmlContent = descContainer.innerHTML;\r\n        if (htmlContent.includes('videoinfodetails')) {\r\n            let parts = htmlContent.split('videoinfodetails');\r\n            \r\n            descContainer.innerHTML = parts[0];\r\n            \r\n            const videoDescPart = document.getElementById('video-description-part');\r\n            if (videoDescPart && parts[1]) {\r\n                videoDescPart.innerHTML = parts[1];\r\n            }\r\n        }\r\n    }\r\n\r\n    // Tabs switching logic\r\n    const tabLabels = document.querySelectorAll('.tabs-nav .tab-btn');\r\n    const tabPanels = document.querySelectorAll('.tab-panel');\r\n\r\n    function switchTab(targetId) {\r\n        tabLabels.forEach(l => l.classList.remove('is-active'));\r\n        tabPanels.forEach(p => p.style.display = 'none');\r\n\r\n        const matchingInput = document.getElementById(targetId);\r\n        const targetPanel = document.getElementById('panel-' + targetId.replace('tab-', ''));\r\n\r\n        if (matchingInput) matchingInput.checked = true;\r\n        if (targetPanel) targetPanel.style.display = 'block';\r\n\r\n        tabLabels.forEach(label => {\r\n            if (label.getAttribute('for') === targetId) {\r\n                label.classList.add('is-active');\r\n            }\r\n        });\r\n    }\r\n\r\n    tabLabels.forEach(label => {\r\n        label.addEventListener('click', function() {\r\n            const targetRadioId = this.getAttribute('for');\r\n            switchTab(targetRadioId);\r\n            history.pushState(null, null, '#' + targetRadioId);\r\n        });\r\n    });\r\n\r\n    // Initial check on load or hash\r\n    if (window.location.hash) {\r\n        const hash = window.location.hash.replace('#', '');\r\n        if (document.getElementById(hash)) {\r\n            switchTab(hash);\r\n        }\r\n    } else {\r\n        const checkedInput = document.querySelector('.tabs-content-container input[type=\"radio\"]:checked');\r\n        if (checkedInput) {\r\n            switchTab(checkedInput.id);\r\n        }\r\n    }\r\n});\r\n</script>\r\n\r\n\r\n<style>\r\n.accordions-tabs-wrapper {\r\n    display: flex;\r\n    flex-direction: column;\r\n    width: 100%;\r\n    margin-top: 20px;\r\n}\r\n\r\n.tabs-nav {\r\n    display: flex;\r\n    flex-direction: row;\r\n    gap: 5px;\r\n    border-bottom: 2px solid #e1e1e1;\r\n}\r\np a{\r\n    color: #7e4227;\r\n}\r\n.tab-btn {\r\n    padding: 12px 20px;\r\n    font-weight: 600;\r\n    color: #333;\r\n    border-bottom: none;\r\n    cursor: pointer;\r\n    border-radius: 4px 4px 0 0;\r\n}\r\n\r\n.tabs-content-container input[type=\"radio\"] {\r\n    display: none;\r\n}\r\n\r\n.tab-panel {\r\n    display: none;\r\n    width: 100%;\r\n    padding: 20px 0;\r\n}\r\n\r\n.tabs-nav .tab-btn.is-active {\r\n    background: #b0c4de !important; \r\n    color: #000000 !important;\r\n    border-color: #99b1d1 !important;\r\n}\r\n\r\n\r\n.tabs-content-container .tab-panel .techdata a[href*=\".pdf\"]{\r\n    background-image: url(data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='25' height='25' viewBox='0 0 482.14 482.14'%3E%3Cpath d='M142.024,310.194c0-8.007-5.556-12.782-15.359-12.782c-4.003,0-6.714,0.395-8.132,0.773v25.69 c1.679,0.378,3.743,0.504,6.588,0.504C135.57,324.379,142.024,319.1,142.024,310.194z'/%3E%3Cpath d='M202.709,297.681c-4.39,0-7.227,0.379-8.905,0.772v56.896c1.679,0.394,4.39,0.394,6.841,0.394 c17.809,0.126,29.424-9.677,29.424-30.449C230.195,307.231,219.611,297.681,202.709,297.681z'/%3E%3Cpath d='M315.458,0H121.811c-28.29,0-51.315,23.041-51.315,51.315v189.754h-5.012c-11.418,0-20.678,9.251-20.678,20.679v125.404 c0,11.427,9.259,20.677,20.678,20.677h5.012v22.995c0,28.305,23.025,51.315,51.315,51.315h264.223 c28.272,0,51.3-23.011,51.3-51.315V121.449L315.458,0z M99.053,284.379c6.06-1.024,14.578-1.796,26.579-1.796 c12.128,0,20.772,2.315,26.58,6.965c5.548,4.382,9.292,11.615,9.292,20.127c0,8.51-2.837,15.745-7.999,20.646 c-6.714,6.32-16.643,9.157-28.258,9.157c-2.585,0-4.902-0.128-6.714-0.379v31.096H99.053V284.379z M386.034,450.713H121.811 c-10.954,0-19.874-8.92-19.874-19.889v-22.995h246.31c11.42,0,20.679-9.25,20.679-20.677V261.748 c0-11.428-9.259-20.679-20.679-20.679h-246.31V51.315c0-10.938,8.921-19.858,19.874-19.858l181.89-0.19v67.233 c0,19.638,15.934,35.587,35.587,35.587l65.862-0.189l0.741,296.925C405.891,441.793,396.987,450.713,386.034,450.713z M174.065,369.801v-85.422c7.225-1.15,16.642-1.796,26.58-1.796c16.516,0,27.226,2.963,35.618,9.282 c9.031,6.714,14.704,17.416,14.704,32.781c0,16.643-6.06,28.133-14.453,35.224c-9.157,7.612-23.096,11.222-40.125,11.222 C186.191,371.092,178.966,370.446,174.065,369.801z M314.892,319.226v15.996h-31.23v34.973h-19.74v-86.966h53.16v16.122h-33.42 v19.875H314.892z' fill='rgb(23, 81, 143)' /%3E%3C/svg%3E);\r\n    background-size: 25px;\r\n    padding: 5px 0 5px 34px;\r\n    background-repeat: no-repeat;\r\n    background-position: left 5px;\r\n    text-decoration: none;\r\n    display: block;\r\n}\r\n.tabs-content-container table{\r\n    width: 100%;\r\n}\r\n.video-sub{\r\n    text-align: center;\r\n}\r\n</style>","components/products/ratings":"\n\n\n<!-- <div class=\"comments_note wb-list-product-reviews\">\n<span class=\"avg-rate bg-re3 d-flex justify-content-center\">\n    <span class=\"rate-tot winter-count\">0</span>\n    <svg width=\"11px\" height=\"11px\"><use xlink:href=\"#reviewStar\"></use></svg>    \n</span>\n</div> -->\n\n\n<div class=\"comments_note wb-list-product-reviews\">\n    <span class=\"avg-rate bg-re3 d-flex justify-content-center\">\n        <span class=\"rate-tot winter-count\">0</span><svg width=\"12px\" height=\"12px\" class=\"cardStar\"><use xlink:href=\"#reviewStar\"></use></svg>\n        <span class=\"or-rate winter-review\">\n            {{#for 1 5}}{{#if ../this.rating '>=' $index}}<span data-review=\"{{../this.rating}}\" class=\"icon icon--ratingFull winter-review-count\"><svg width=\"12px\" height=\"12px\"><use xlink:href=\"#reviewStar\"></use></svg></span>{{else}}<span class=\"icon icon--ratingEmpty\"><svg width=\"12px\" height=\"12px\"><use xlink:href=\"#reviewStarEmpty\"></use></svg></span>{{/if}}{{/for}}{{{snippet 'product_rating'}}}\n        </span>\n    </span>\n</div>","components/products/reviews":"{{#if reviews.total}}\n<section class=\"toggle productReviews\" id=\"product-reviews\" data-product-reviews>\n    <h4 class=\"toggle-title\">\n        {{lang 'products.reviews.header' total=reviews.total}}\n        {{#if theme_settings.show_product_reviews}}\n            <a class=\"toggleLink is-open\" data-collapsible href=\"#productReviews-content\">\n                <span class=\"toggleLink-text toggleLink-text--on\">\n                    {{lang 'products.reviews.hide'}}\n                </span>\n                <span class=\"toggleLink-text toggleLink-text--off\">\n                    {{lang 'products.reviews.show'}}\n                </span>\n            </a>\n        {{/if}}\n    </h4>\n    <div class=\"toggle-content is-open\" id=\"productReviews-content\" aria-hidden=\"false\">\n        <ul class=\"productReviews-list\" id=\"productReviews-list\">\n            {{#each reviews.list}}\n            <li class=\"productReview\">\n                <article>\n                    <header>\n                        <span class=\"productReview-rating rating--small\">\n                            {{> components/products/ratings rating=rating}}\n                            <span class=\"productReview-ratingNumber\">{{ rating }}</span>\n                        </span>\n                        <h5 class=\"productReview-title\">{{{ sanitize title }}}</h5>\n                        {{#if name}}\n                            <p class=\"productReview-author\">\n                                {{{lang 'products.reviews.post_on_by' date=date name=(sanitize name) }}}\n                            </p>\n                        {{else}}\n                            <p class=\"productReview-author\">\n                                {{lang 'products.reviews.post_on_by' date=date name=(lang 'products.reviews.anonymous_poster')}}\n                            </p>\n                        {{/if}}\n                    </header>\n                    <p class=\"productReview-body\">{{{ sanitize text }}}</p>\n                </article>\n            </li>\n            {{/each}}\n        </ul>\n        {{> components/common/paginator pagination.reviews reload=true}}\n    </div>\n</section>\n{{/if}}\n","components/products/videos":"<div class=\"section-spacing\">\r\n    <div class=\"container\">\r\n        <section class=\"toggle videoGallery\" data-video-gallery>\r\n            <div class=\"toggle-content is-open\" id=\"videoGallery-content\">\r\n                \r\n                <div id=\"video-description-part\" style=\"margin-bottom: 20px;\"></div>\r\n\r\n                {{#if this.featured}}\r\n                <div class=\"videoGallery-main widescreen\" style=\"margin-bottom: 20px;\">\r\n                    <iframe\r\n                        id=\"player\"\r\n                        title=\"productVideo\"\r\n                        class=\"lazyload\"\r\n                        type=\"text/html\"\r\n                        width=\"640\"\r\n                        height=\"390\"\r\n                        frameborder=\"0\"\r\n                        webkitAllowFullScreen\r\n                        mozallowfullscreen\r\n                        allowFullScreen\r\n                        data-src=\"//www.youtube.com/embed/{{this.featured.id}}?rel=0\"\r\n                        data-video-player>\r\n                    </iframe>\r\n                </div>\r\n                {{/if}}\r\n\r\n                {{#if this.list.length}}\r\n                <ul class=\"videoGallery-list\" style=\"list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 15px;\">\r\n                    {{#each this.list}}\r\n                        <li class=\"videoGallery-item\" style=\"width: calc(33.333% - 10px);\">\r\n                           <a href=\"#\" class=\"video {{#if @first}}is-active{{/if}}\" data-video-item data-video-id=\"{{id}}\" style=\"text-decoration: none; color: inherit; display: block;\">\r\n                                <div class=\"video-figure\">\r\n                                 <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"//i.ytimg.com/vi/{{id}}/default.jpg\" style=\"width: 100%; height: auto;\"/>\r\n                                </div>\r\n                                <div class=\"video-body\" style=\"padding-top: 8px;\">\r\n                                    <h5 class=\"video-title\" style=\"font-size: 14px; font-weight: 600; margin: 0 0 5px 0;\">{{title_long}}</h5>\r\n                                    <p class=\"video-description\" style=\"font-size: 12px; color: #666; margin: 0;\">{{description_short}}</p>\r\n                                </div>\r\n                           </a>\r\n                       </li>\r\n                    {{/each}}\r\n                </ul>\r\n                {{/if}}\r\n\r\n            </div>\r\n        </section>\r\n    </div>\r\n</div>"}
