{"components/cms/newsletter":"{{#if theme_settings.show_home_newsletter}}\n<div class=\"section-spacing sectionLoad newsletter_wrapper\">\n    <div class=\"newsletter-bg\">\n        <div class=\"container\">\n            <div class=\"newsletterBox\">\n                <h3>{{theme_settings.newsletter_title}}</h3>\n                {{#if settings.show_newsletter_box}}\n                    {{> components/common/subscription-form}}\n                {{/if}}\n            </div>\n        </div>\n    </div>\n</div>\n{{/if}}","components/common/subscription-form":"<div class=\"subscription-form-wrap\">\n<!-- <h3 class=\"footer-info-heading\">{{lang 'newsletter.subscribe'}}</h3> -->\n<p>{{theme_settings.Footer-Email-OfferText}}</p>\n\n<form class=\"form\" action=\"{{urls.subscribe.action}}\" method=\"post\">\n    <fieldset class=\"form-fieldset\">\n        <input type=\"hidden\" name=\"action\" value=\"subscribe\">\n        <input type=\"hidden\" name=\"nl_first_name\" value=\"bc\">\n        <input type=\"hidden\" name=\"check\" value=\"1\">\n        <div class=\"form-field\">\n            <label class=\"form-label is-srOnly\" for=\"nl_email\">{{lang 'common.email_address'}}</label>\n            <div class=\"form-prefixPostfix wrap\">\n                <input class=\"form-input\"\n                       id=\"nl_email\"\n                       name=\"nl_email\"\n                       type=\"email\"\n                       value=\"{{customer.email}}\"\n                       placeholder=\"{{lang 'newsletter.email_placeholder'}}\"\n                       aria-describedby=\"alertBox-message-text\"\n                       aria-required=\"true\"\n                       autocomplete=\"email\"\n                       required\n                >\n                <div class=\"subscription-action\">\n                    <input class=\"button button--primary form-prefixPostfix-button--postfix\"\n                        type=\"submit\"\n                        value=\"{{lang 'newsletter.subscribe_submit'}}\"\n                    >\n                    <!-- <svg height=\"20px\" width=\"20px\"><use xlink:href=\"#message_send\"></use></svg> -->\n                </div>\n            </div>\n            {{#if settings.show_newsletter_summary }}\n                <div class=\"footer-newsletter-summary\">{{settings.newsletter_summary}}</div>\n            {{/if}}\n        </div>\n    </fieldset>\n</form>\n</div>"}
