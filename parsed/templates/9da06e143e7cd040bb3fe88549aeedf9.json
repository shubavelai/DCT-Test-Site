{"components/cms/home-contact":"{{#if theme_settings.show_home_contactus}}\r\n<div class=\"section-spacing sectionLoad\">\r\n    <div class=\"container\">\r\n        <div class=\"home-contact-detail row pre-row\">\r\n            <div class=\"col-12 col-lg-6 col-sm-12 pre-col\">\r\n                <div class=\"home-contact-form\">\r\n                    <div class=\"top-info\">\r\n                        <h4 class=\"form-title\">{{theme_settings.contactformtitle}}</h4>\r\n                        <p>{{theme_settings.contactformsubtitle}}</p>\r\n                    </div>\r\n                    <div class=\"form-wrap\">\r\n                        <div class=\"ask-an-expert-popup\">\r\n                            <div class=\"ask-inner\">\r\n                                <div class=\"ask-body\">\r\n                                    <div class=\"ask-form-body\">\r\n                                        <div class=\"loadingOverlay\">&nbsp;</div>\r\n                                        <form data-contact-form class=\"ask-form\" action=\"/pages.php?action=sendContactForm\" method=\"post\">\r\n                \r\n                                            <input type=\"hidden\" name=\"page_id\" id=\"page_id\" value=\"{{theme_settings.os_ae_web_page_id}}\">\r\n                                            <input type=\"hidden\" name=\"page_content\" id=\"page_content\" value=\"{{theme_settings.os_ae_subjext}}\">\r\n\r\n                                            <div class=\"form-row form-row--half\">\r\n                                                <div class=\"form-field\">\r\n                                                    <label class=\"form-label\" for=\"contact_fullname\">First Name</label>\r\n                                                    <input class=\"form-input\" type=\"text\" id=\"contact_fullname\" name=\"contact_fullname\" value=\"\" placeholder=\"First name\" required />\r\n                                                </div>\r\n\r\n                                                <div class=\"form-field\">\r\n                                                    <label class=\"form-label\" for=\"contact_lastname\">Last name</label>\r\n                                                    <input class=\"form-input\" type=\"text\" id=\"contact_lastname\" name=\"contact_lastname\" value=\"\" placeholder=\"Last name\" required />\r\n                                                </div>\r\n                                            </div>\r\n\r\n                                            <div class=\"form-field\">\r\n                                                <label class=\"form-label\" for=\"contact_email\">Your Email Address</label>\r\n                                                <input class=\"form-input\" type=\"email\" id=\"contact_email\" name=\"contact_email\" value=\"\" placeholder=\"Email address\" required />\r\n                                            </div>\r\n\r\n                                            <div class=\"form-field\">\r\n                                                <label class=\"form-label\" for=\"contact_phone\">Phone Number</label>\r\n                                                <input class=\"form-input\" type=\"text\" id=\"contact_phone\" name=\"contact_phone\" value=\"\" placeholder=\"Phone number\">\r\n                                            </div>\r\n\r\n                                            <div class=\"form-field comment-area\">\r\n                                                <label class=\"form-label\" for=\"contact_comment_area\">Submit Message</label>\r\n                                                <textarea name=\"contact_question\" cols=\"30\" rows=\"5\" class=\"form-input\" id=\"contact_comment_area\" placeholder=\"Enter your Message\" required=\"true\" required></textarea>\r\n                                            </div>\r\n\r\n                                            <div class=\"form-field\" style=\"display: none;\">\r\n                                                <textarea name=\"contact_question\" id=\"contact_question\" rows=\"1\" cols=\"50\" class=\"form-input\"></textarea>\r\n                                            </div>\r\n\r\n                                            <div class=\"form-actions\">\r\n                                                <div id=\"rcaptcha\" class=\"g-recaptcha\" data-sitekey=\"6LcjX0sbAAAAACp92-MNpx66FT4pbIWh-FTDmkkz\">&nbsp;</div>\r\n                                            </div>\r\n                                            <div class=\"form-actions\">\r\n                                                <button type=\"submit\" class=\"button button--primary\" id=\"ask-an-expert-button\">{{lang 'forms.contact_us.submit' }}</button>\r\n                                            </div>\r\n                                        </form>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <script src=\"https://www.google.com/recaptcha/api.js\" async=\"\" defer=\"\"></script>\r\n\r\n\r\n                    </div>\r\n                    <div class=\"bottom-info\">\r\n                        <div class=\"row\">\r\n                            <div class=\"col-6 col-xl-6 contact-info-wrapper\">\r\n                                <div class=\"contact-info-item\">\r\n                                    <h4 class=\"d-flex contact-icon\">\r\n                                        <svg width=\"17px\" height=\"16px\"><use xlink:href=\"#contact_message\"></use></svg>{{theme_settings.contact_chat_title}}</h4>\r\n                                    <p>{{theme_settings.contact_chat_content}}</p>\r\n                                    <p><a href=\"tel:{{theme_settings.contact_chat_mail}}\">{{theme_settings.contact_chat_mail}}</a></p>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-6 col-xl-6 contact-info-wrapper\">\r\n                                <div class=\"contact-info-item\">\r\n                                    <h4 class=\"d-flex contact-icon\">\r\n                                        <a href=\"https://www.decorativeceilingtiles.net/contact-us/\" style=\"display:flex; align-items:center; color:inherit; text-decoration:none;\"><svg width=\"16px\" height=\"16px\"><use xlink:href=\"#contact_call\"></use></svg>{{theme_settings.contact_title}}</a></h4>\r\n                                    <p>{{theme_settings.contact_content}}</p>\r\n                                    <p><a href=\"tel:{{theme_settings.contact_number}}\">{{theme_settings.contact_number}}</a></p>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-lg-6 col-sm-12 pre-col\">\r\n                <div class=\"contact-location-map\">\r\n                    <div class=\"map-iframe\">\r\n                        <iframe src=\"{{theme_settings.map_iframe1}}{{theme_settings.map_iframe2}}{{theme_settings.map_iframe3}}{{theme_settings.map_iframe4}}{{theme_settings.map_iframe5}}{{theme_settings.map_iframe6}}\" width=\"100%\" height=\"100%\" style=\"border:0;\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" title=\"locationMap\"></iframe>\r\n                    </div> \r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n{{/if}}"}
