    <a class=\"navUser-action head_user_icon d-flex\"  data-dropdown=\"account-dropdown\" href=\"#\">\r\n                    <span class=\"svgbg list-inline\">\r\n                        <svg height=\"22px\" width=\"20px\"><use xlink:href=\"#cuser\"></use></svg>\r\n                    </span>\r\n                    <div class=\"user-detail\">\r\n                        {{#if customer}}\r\n                            <span class=\"user-name\">{{lang 'Hello! '}}{{first (split customer.name \" \") }}</span>\r\n                        {{else}}\r\n                            <span class=\"navUser-item--accountLabel\">{{lang 'common.login'}}</span>\r\n                        {{/if}}\r\n                    </div>\r\n                </a>\r\n                <ul class=\"dropdown-menu user-down dropdown-menu-left headlog\" id=\"account-dropdown\" data-dropdown-content aria-hidden=\"false\">\r\n                    <li class=\"text-left\">{{lang 'Access account and manage orders'}}</li>\r\n                    {{#if customer.store_credit.value '>' 0}}\r\n                        <div class=\"mystorecredit\">\r\n                            <ul class=\"navUser-section\">\r\n                                <li class=\"navUser-item\">\r\n                                    <a class=\"navUser-action navUser-action--storeCredit has-dropdown\"\r\n                                    data-dropdown=\"storeCredit-dropdown\"\r\n                                    aria-controls=\"storeCredit-dropdown\"\r\n                                    href=\"{{urls.cart}}\"\r\n                                    aria-label=\"{{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}\"\r\n                                    >\r\n                                        <span class=\"navUser-divider\">\r\n                                            {{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}\r\n                                        </span>\r\n                                    </a>\r\n                                    <ul class=\"dropdown-menu\" id=\"storeCredit-dropdown\" data-dropdown-content aria-hidden=\"true\" tabindex=\"-1\">\r\n                                        {{{lang 'common.store_credit' store_credit=customer.store_credit.formatted}}}\r\n                                    </ul>\r\n                                </li>\r\n                            </ul>\r\n                        </div>\r\n                    {{else}}\r\n                        {{#if customer}}\r\n                            <li class=\"text-left\">your store credit is 0 {{lang 'common.currency' code=currency_selector.active_currency_code}}</li>\r\n                        {{/if}}\r\n                    {{/if}}\r\n                    {{#if customer}}\r\n                        <li class=\"actionBtn-dropdown\">\r\n                            <a class=\"navUser-action dropdown-menu-item sign_out dro\" href=\"{{urls.auth.logout}}\">{{lang 'common.logout'}}</a>\r\n                        </li>\r\n                        <li class=\"actionBtn-dropdown account-dropdown\">\r\n                            <a class=\"navUser-action dropdown-menu-item my_account dro\" href=\"{{urls.account.index}}\">{{lang 'common.account'}}</a>\r\n                        </li>\r\n                    {{else}}\r\n                        <li class=\" mylogin actionBtn-dropdown\">\r\n                            <a class=\"navUser-action dropdown-menu-item dro\" href=\"{{urls.auth.login}}\">{{lang 'common.login'}}</a>\r\n                        </li>\r\n                    {{#if settings.account_creation_enabled}}\r\n                        <li class=\" mycreat actionBtn-dropdown\">\r\n                            <a class=\"navUser-action dropdown-menu-item dro\" href=\"{{urls.auth.create_account}}\">{{lang 'common.sign_up'}}</a>\r\n                        </li>\r\n                    {{/if}}\r\n                    {{/if}}\r\n                    <li class=\" actionBtn-dropdown\">\r\n                            <a class=\"navUser-action navUser-item--compare\"\r\n                            href=\"{{urls.compare}}\"\r\n                            data-compare-nav\r\n                            aria-label=\"{{lang 'common.compare'}}\"\r\n                            >\r\n                                {{lang 'common.compare'}}\r\n                            </a>\r\n                    </li>\r\n                    <!-- Wishlist Icon -->\r\n                    <li class=\"mywishcus actionBtn-dropdown\">\r\n                        <div class=\"navUser-item navUser-item--wishlist\">\r\n                                <a class=\"cart-button cart-button--wishlist dropdown-menu-item navUser-action\" title=\"{{lang 'account.nav.wishlists'}}\" href=\"{{urls.account.wishlists.all}}\">\r\n                                    <span>{{lang \"common.wishlist\"}}</span>\r\n                                </a>\r\n                        </div>\r\n                    </li>\r\n                    {{#if settings.gift_certificates_enabled}}\r\n                        <li class=\"navUser-item mygift actionBtn-dropdown\">\r\n                            <a class=\"navUser-action\"\r\n                            href=\"{{urls.gift_certificate.purchase}}\"\r\n                            aria-label=\"{{lang 'common.gift_cert'}}\"\r\n                            >\r\n                                {{lang 'common.gift_cert'}}\r\n                            </a>\r\n                        </li>\r\n                    {{/if}}\r\n                </ul>\r\n            </li>\r\n            <li class=\"navUser-item navUser-item--cart header-cart--{{theme_settings.cart-type}}\">\r\n                <a class=\"navUser-action d-flex\"\r\n                data-cart-preview\r\n                data-dropdown=\"cart-preview-dropdown\"\r\n                data-options=\"align:right\"\r\n                href=\"{{urls.cart}}\"\r\n                aria-label=\"{{lang 'cart.nav_aria_label'}}\"\r\n                >\r\n                    <svg height=\"23px\" width=\"24px\"><use xlink:href=\"#cart\"></use></svg>\r\n                    <span class=\"navUser-item-cartLabel\">{{lang 'common.cart'}}</span>\r\n                    <span class=\"countPill cart-quantity\"></span>\r\n                </a>\r\n\r\n                <div class=\"dropdown-menu\" id=\"cart-preview-dropdown\" data-dropdown-content aria-hidden=\"true\"></div>\r\n            </li>\r\n        </ul>\r\n        <div class=\"dropdown dropdown--quickSearch\" id=\"quickSearch\" aria-hidden=\"true\" data-prevent-quick-search-close>\r\n            {{> components/common/quick-search name='nav-quick-search'}}\r\n        </div>\r\n    </div>\r\n    </div>\r\n\r\n\r\n    \r\n    <div class=\"navPages-container desktopMenu\">\r\n        <div class=\"container\">\r\n            <div class=\"row\">\r\n                <div class=\"col-lg-2 col-md-3 col-sm-2 col-xs-12 head-menu text-left menuwidth\">\r\n                    <div class=\"navPages-container\" id=\"menu\" data-menu> \r\n                        {{> components/common/navigation-menu}}\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-7 col-md-7 col-sm-6 col-xs-12 nav-head text-center\">\r\n                    {{#unless theme_settings.hide_content_navigation}}\r\n                        <ul>\r\n                        {{#each pages}}\r\n                            <li class=\"navPages-item navPages-item-page\">\r\n                                <a class=\" head navPages-action{{#if name '==' ../page.title}} activePage{{/if}}\"\r\n                                    href=\"{{url}}\"\r\n                                    aria-label=\"{{name}}\"\r\n                                    >\r\n                                    {{name}}\r\n                                </a>\r\n                            </li>\r\n                        {{/each}}\r\n                        </ul>\r\n    