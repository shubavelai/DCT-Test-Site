{"components/common/channel-selector-mobile":"{{#if theme_settings.channels.length '>' 1}}\n<a href=\"#\"\n   class=\"navPages-action has-subMenu\"\n   data-collapsible=\"navPages-channel\"\n   aria-controls=\"navPages-channel\"\n   aria-expanded=\"false\"\n   aria-label=\"\n    {{#each theme_settings.channels}}\n        {{#if is_active}}\n            {{lang 'common.channel' code=code}}\n        {{/if}}\n    {{/each}}\n   \"\n>\n    {{#each theme_settings.channels}}\n        {{#if is_active}}\n            {{lang 'common.channel' code=code}}\n        {{/if}}\n    {{/each}}\n    <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\n        <svg>\n            <use href=\"#icon-chevron-down\"></use>\n        </svg>\n    </i>\n</a>\n<div class=\"navPage-subMenu\" id=\"navPages-channel\" aria-hidden=\"true\" tabindex=\"-1\">\n    <ul class=\"navPage-subMenu-list\">\n        {{#each theme_settings.channels}}\n        <li class=\"navPage-subMenu-item\">\n            <a href=\"{{{switch_url}}}\"\n               class=\"navPage-subMenu-action navPages-action\"\n               aria-label=\"{{name}}\"\n               data-channel-code=\"{{{code}}}\"\n               data-warning=\"{{lang 'common.channel_switch_warning'}}\"\n            >\n                {{name}}\n            </a>\n        </li>\n        {{/each}}\n    </ul>\n</div>\n{{/if}}\n","components/common/currency-selector":"{{#if currency_selector.currencies.length '>' 1}}\n<ul class=\"navUser-section\">\n    <li class=\"navUser-item\">\n        <div class=\"navUser-action navUser-action--currencySelector has-dropdown\"\n           data-dropdown=\"currencySelection\"\n        >\n            {{lang 'common.currency' code=currency_selector.active_currency_code}}\n            <i class=\"icon\" aria-hidden=\"true\">\n                <svg>\n                    <use href=\"#icon-chevron-down\" />\n                </svg>\n            </i>\n        </div>\n        <ul class=\"dropdown-menu\" id=\"currencySelection\"