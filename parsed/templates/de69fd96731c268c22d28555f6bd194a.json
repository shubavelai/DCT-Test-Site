                  </li>\r\n                \r\n                            {{#each children}}\r\n                                <li class=\"navPages-item navPages-item-page{{#if children}} has-subMenu{{/if}}\">\r\n                                    <a class=\"navPages-action{{#if children}} has-subMenu{{/if}}\" href=\"{{url}}\">\r\n                                        {{name}}\r\n                                        {{#if children}}\r\n                                            <span class=\"collapsible-iconWrapper\">\r\n                                                <i class=\"icon navPages-action-moreIcon main-moreicon\" data-collapsible=\"navPages-23\" aria-hidden=\"true\" aria-label=\"\" aria-controls=\"navPages-23\" aria-expanded=\"false\">\r\n                                                    <svg><use xlink:href=\"#icon-chevron-down\"></use></svg>\r\n                                                </i>\r\n                                            </span>\r\n                                        {{/if}}\r\n                                    </a>\r\n                                    \r\n                                    {{#if children}}\r\n                                        <div class=\"navPage-subMenu navPage-subMenu-horizontal\" id=\"navPages-submenu-{{id}}\" aria-hidden=\"true\" tabindex=\"-1\">\r\n                                            <div class=\"container\">\r\n                                                <ul class=\"navPage-subMenu-list navPage-subMenu-list-cols\">\r\n                                                    {{#each children}}\r\n                                                        <li class=\"navPage-subMenu-item\">\r\n                                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"{{url}}\">{{name}}</a>\r\n                                                            \r\n                                                            {{#if children}}\r\n                                                                <ul class=\"navPage-childList\">\r\n                                                                    {{#each children}}\r\n                                                                        <li class=\"navPage-childList-item\">\r\n                                                                            <a class=\"navPage-childList-action\" href=\"{{url}}\">{{name}}</a>\r\n                                                                        </li>\r\n                                                                    {{/each}}\r\n                                                                </ul>\r\n                                                            {{/if}}\r\n                                                        </li>\r\n                                                    {{/each}}\r\n                                                </ul>\r\n                                            </div>\r\n                                        </div>\r\n                                    {{/if}}\r\n                                </li>\r\n                            {{/each}}\r\n                        {{/or}}\r\n                    {{/each}}\r\n                </ul>\r\n     \r\n        </div>\r\n\r\n    <ul class=\"navPages-list navPages-navPages mobilePages\" style=\"display: none;\">\r\n        {{#unless theme_settings.hide_content_navigation}}\r\n            {{#each pages}}\r\n                    <li class=\"navPages-item navPages-item-page\">\r\n                    <a class=\" head navPages-action{{#if name '==' ../page.title}} activePage{{/if}}\"\r\n                        href=\"{{url}}\"\r\n                        aria-label=\"{{name}}\"\r\n                        >\r\n                        {{name}}\r\n                    </a>\r\n                    </li>\r\n            {{/each}}\r\n        {{/unless}}\r\n    </ul>\r\n    \r\n    <ul class=\"navPages-list navPages-list--user\">\r\n        {{#if currency_selector.currencies.length '>' 1}}\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action has-subMenu\"\r\n                   href=\"#\"\r\n                   data-collapsible=\"navPages-currency\"\r\n                   aria-controls=\"navPages-currency\"\r\n                   aria-expanded=\"false\"\r\n                   aria-label=\"{{lang 'common.currency' code=currency_selector.active_currency_code}}\"\r\n                >\r\n                    {{lang 'common.currency' code=currency_selector.active_currency_code}}\r\n                    <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                        <svg>\r\n                            <use href=\"#icon-chevron-down\"></use>\r\n                        </svg>\r\n                    </i>\r\n                </a>\r\n                <div class=\"navPage-subMenu\" id=\"navPages-currency\" aria-hidden=\"true\" tabindex=\"-1\">\r\n                    <ul class=\"navPage-subMenu-list\">\r\n                        {{#each currency_selector.currencies}}\r\n                        <li class=\"navPage-subMenu-item\">\r\n                            <a class=\"navPage-subMenu-action navPages-action\"\r\n                               href=\"{{{switch_url}}}\"\r\n                               aria-label=\"{{name}}\"\r\n                               data-currency-code=\"{{{code}}}\"\r\n                               {{#if cart_currency_switch_url.length '>' 0 }}\r\n                               data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"\r\n                               {{/if}}\r\n                               data-warning=\"{{lang 'common.currency_switch_promotion'}}\"\r\n                            >\r\n                                {{#if is_active}}\r\n                                    <strong>{{name}}</strong>\r\n                                {{else}}\r\n                                    {{name}}\r\n                                {{/if}}\r\n                            </a>\r\n                        </li>\r\n                        {{/each}}\r\n                    </ul>\r\n                </div>\r\n            </li>\r\n        {{/if}}\r\n        {{#if theme_settings.show_channels}}\r\n            <li class=\"navPages-item\">\r\n                {{> components/common/channel-selector-mobile}}\r\n            </li>\r\n        {{/if}}\r\n        {{#if settings.gift_certificates_enabled}}\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action\"\r\n                   href=\"{{urls.gift_certificate.purchase}}\"\r\n                   aria-label=\"{{lang 'common.gift_cert'}}\"\r\n                >\r\n                    {{lang 'common.gift_cert'}}\r\n                </a>\r\n            </li>\r\n        {{/if}}\r\n        {{#if customer.store_credit.value '>' 0}}\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action navPages-action--storeCredit\">\r\n                    {{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}\r\n                </a>\r\n            </li>\r\n        {{/if}}\r\n        {{#if theme_settings.product_list_display_mode '==' 'list'}}\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action navPages-action--compare\"\r\n                   href=\"{{urls.compare}}\"\r\n                   data-compare-nav\r\n                   aria-label=\"{{lang 'common.compare'}}\"\r\n                >\r\n                    {{lang 'common.compare'}}\r\n                    <span class=\"countPill countPill--positive countPill--alt\"></span>\r\n                </a>\r\n            </li>\r\n        {{/if}}\r\n        {{#if customer}}\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action has-subMenu\"\r\n                   href=\"{{urls.account.index}}\"\r\n                   data-collapsible=\"navPages-account\"\r\n                   aria-label=\"{{lang 'common.account'}}\"\r\n                >\r\n                    {{lang 'common.account'}}\r\n                    <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                        <svg><use href=\"#icon-chevron-down\" /></svg>\r\n                    </i>\r\n                </a>\r\n                <div class=\"navPage-subMenu\" id=\"navPages-account\" aria-hidden=\"true\" tabindex=\"-1\">\r\n                    <ul class=\"navPage-subMenu-list\">\r\n                        <li class=\"navPage-subMenu-item\">\r\n                            <a class=\"navPage-subMenu-action navPages-action\"\r\n                               href=\"{{urls.account.orders.all}}\"\r\n                               aria-label=\"{{lang 'account.nav.orders'}}\"\r\n                            >\r\n                                {{lang 'account.nav.orders'}}\r\n                            </a>\r\n                        </li>\r\n                        {{#if settings.returns_enabled}}\r\n                            <li class=\"navPage-subMenu-item\">\r\n                                <a class=\"navPage-subMenu-action navPages-action\"\r\n                                   href=\"{{urls.account.returns}}\"\r\n                                   aria-label=\"{{lang 'account.nav.returns'}}\"\r\n                                >\r\n                                    {{lang 'account.nav.returns'}}\r\n                                </a>\r\n                            </li>\r\n                        {{/if}}\r\n                        <li class=\"navPage-subMenu-item\">\r\n                            <a class=\"navPage-subMenu-action navPages-action\"\r\n                               href=\"{{urls.account.inbox}}\"\r\n                               aria-label=\"{{lang 'account.mobile_nav.messages'}}\"\r\n                            >\r\n                                {{lang 'account.mobile_nav.messages'}}\r\n                            </a>\r\n                        </li>\r\n                        <li class=\"navPage-subMenu-item\">\r\n                            <a class=\"navPage-subMenu-action navPages-action\"\r\n                               href=\"{{urls.account.addresses}}\"\r\n                               aria-label=\"{{lang 'account.nav.addresses'}}\"\r\n                            >\r\n                                {{lang 'account.nav.addresses'}}\r\n                            </a>\r\n                        </li>\r\n                        {{#if settings.show_payment_methods}}\r\n                            <li class=\"navPage-subMenu-item\">\r\n                                <a class=\"navPage-subMenu-action navPages-action\"\r\n                                   href=\"{{urls.account.payment_methods.all}}\"\r\n                                   aria-label=\"{{lang 'account.nav.payment_methods'}}\"\r\n                                >\r\n                                    {{lang 'account.nav.payment_methods'}}\r\n                                </a>\r\n                            </li>\r\n                        {{/if}}\r\n                        <li class=\"navPage-subMenu-item\">\r\n                            <a class=\"navPage-subMenu-action navPages-action\"\r\n                               href=\"{{urls.account.wishlists.all}}\"\r\n                               aria-label=\"{{lang 'account.mobile_nav.wishlists'}}\"\r\n                            >\r\n                                {{lang 'account.mobile_nav.wishlists'}}\r\n                            </a>\r\n                        </li>\r\n                        <li class=\"navPage-subMenu-item\">\r\n                            <a class=\"navPage-subMenu-action navPages-action\"\r\n                               href=\"{{urls.account.recent_items}}\"\r\n                               aria-label=\"{{lang 'account.nav.recently_viewed'}}\"\r\n                            >\r\n                                {{lang 'account.nav.recently_viewed'}}\r\n                            </a>\r\n                        </li>\r\n                        <li class=\"navPage-subMenu-item\">\r\n                            <a class=\"navPage-subMenu-action navPages-action\"\r\n                               href=\"{{urls.account.details}}\"\r\n                               aria-label=\"{{lang 'account.nav.settings'}}\"\r\n                            >\r\n                                {{lang 'account.nav.settings'}}\r\n                            </a>\r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n            </li>\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action\"\r\n                   href=\"{{urls.auth.logout}}\"\r\n                   aria-label=\"{{lang 'common.logout'}}\"\r\n                >\r\n                    {{lang 'common.logout'}}\r\n                </a>\r\n            </li>\r\n        {{else}}\r\n            <li class=\"navPages-item accountItem\">\r\n                <a class=\"navPages-action\"\r\n                   href=\"{{urls.auth.login}}\"\r\n                   aria-label=\"{{lang 'common.login'}}\"\r\n                >\r\n                    {{lang 'common.login'}}\r\n                </a>\r\n                {{#if settings.account_creation_enabled}}\r\n                    {{lang 'common.or'}}\r\n                    <a class=\"navPages-action\"\r\n                       href=\"{{urls.auth.create_account}}\"\r\n                       aria-label=\"{{lang 'common.sign_up'}}\"\r\n                    >\r\n                        {{lang 'common.sign_up'}}\r\n                    </a>\r\n                {{/if}}\r\n            </li>\r\n        {{/if}}\r\n        {{#if theme_settings.social_icon_placement_top}}\r\n            <li class=\"navPages-item\">\r\n                {{> components/common/social-links}}\r\n            </li>\r\n        {{/if}}\r\n    </ul>\r\n    \r\n</nav>\r\n\r\n\r\n","components/common/quick-search":"{{#if theme_settings.logo-position '===' 'center'}}\n<li id=\"search\" class=\"desktop-search d-inline-block sideb siden\">\n    {{{ snippet \"forms_search\"}}}\n    <div class=\"d-search\">\n        <button  class=\"search-toggle\" data-toggle=\"collapse\" onclick=\"openSearch()\" aria-label=\"{{lang \"search.quick_search.input_label\"}}\">\n        \n            <svg height=\"24px\" width=\"24px\"><use xlink:href=\"#mysearch\"></use></svg>\n        </button>\n    </div>\n    <div id=\"search\" class=\"wbSearch\">\n            <form class=\"form\" action=\"{{urls.search}}\">\n            <fieldset class=\"form-fieldset\">\n                <div class=\"wb-search input-group\">\n                    <label class=\"is-srOnly\">{{lang \"search.quick_search.input_label\"}}</label>\n                    <input class=\"form-input form-control\" data-search-quick name=\"search_query\" data-error-message=\"{{lang 'search.error.empty_field'}}\" placeholder=\"{{lang 'search.quick_search.input_placeholder'}}\" autocomplete=\"off\">\n                    <div class=\"input-group-btn\"><button class=\"wb-search-btn\" align=\"center\" type=\"submit\" value=\"{{lang 'search.results.form_button_text'}}\n                    \"><svg width=\"20px\" height=\"20px\">\n                        <use xlink:href=\"#mysearch\"></use>\n                        </svg>\n                        \n                        <!-- {{lang \"search.quick_search.input_label\"}} -->\n                    </button>\n                    <a href=\"javascript:void(0)\" class=\"closebtn close-nav\" onclick=\"closeSearch()\" aria-label=\"close-nav\">X</a> \n                    </div>\n                </div>\n            </fieldset>\n        </form>\n        <section class=\"quickSearchResults\" data-bind=\"html: results\"></section>\n    \n    </div>\n</li>\n{{else}}\n{{#if theme_settings.logo-position '===' 'left'}}\n<div id=\"search\" class=\"\">\n        <form class=\"form\" action=\"{{urls.search}}\">\n        <fieldset class=\"form-fieldset\">\n            <div class=\"wb-search input-group\">\n                <label class=\"is-srOnly\">{{lang \"search.quick_search.input_label\"}}</label>\n                <input class=\"form-input form-control\" data-search-quick name=\"search_query\" data-error-message=\"{{lang 'search.error.empty_field'}}\" placeholder=\"{{lang 'search.quick_search.input_placeholder'}}\" autocomplete=\"off\">\n                <div class=\"input-group-btn\">\n                    <button class=\"wb-search-btn\" align=\"center\" type=\"submit\" value=\"{{lang 'search.results.form_button_text'}}\">\n                        {{lang \"search.quick_search.input_label\"}}\n                    </button>\n                </div>\n            </div>\n        </fieldset>\n    </form>\n    <section class=\"quickSearchResults\" data-bind=\"html: results\"></section>\n</div>\n{{else}}\n{{#if theme_settings.logo-position '===' 'right'}}\n<div id=\"search\" class=\"\">\n        <form class=\"form\" action=\"{{urls.search}}\">\n        <fieldset class=\"form-fieldset\">\n            <div class=\"wb-search input-group\">\n                <label class=\"is-srOnly\">{{lang \"search.quick_search.input_label\"}}</label>\n                <input class=\"form-input form-control\" data-search-quick name=\"search_query\" data-error-message=\"{{lang 'search.error.empty_field'}}\" placeholder=\"{{lang 'search.quick_search.input_placeholder'}}\" autocomplete=\"off\">\n                <div class=\"input-group-btn\"><button class=\"wb-search-btn\" align=\"center\" type=\"submit\" value=\"{{lang 'search.results.form_button_text'}}\n                \">\n                    {{lang \"search.quick_search.input_label\"}}\n                </button>\n                </div>\n            </div>\n        </fieldset>\n    </form>\n    <section class=\"quickSearchResults\" data-bind=\"html: results\"></section>\n</div>\n{{/if}}\n{{/if}}\n{{/if}}","components/common/social-links":"{{#if social_media}}\n    <ul class=\"socialLinks socialLinks--alt\">\n        {{#each social_media}}\n            {{#if display_name '===' 'twitter'}}\n                <li class=\"socialLinks-item\">\n                    <a class=\"icon icon--x\"\n                    href=\"{{url}}\"\n                    target=\"_blank\"\n                    rel=\"noopener\"\n                    title=\"X\"\n                    >\n                        <span class=\"aria-description--hidden\">X</span>\n                        <svg>\n                            <use href=\"#icon-x\"/>\n                        </svg>\n                    </a>\n                </li>\n            {{else}}\n                <li class=\"socialLinks-item\">\n                    <a class=\"icon icon--{{display_name}}\"\n                    href=\"{{url}}\"\n                    target=\"_blank\"\n                    rel=\"noopener\"\n                    title=\"{{{capitalize display_name}}}\"\n                    >\n                        <span class=\"aria-description--hidden\">{{{capitalize display_name}}}</span>\n                        <svg>\n                            <use href=\"#icon-{{display_name}}\"/>\n                        </svg>\n                    </a>\n                </li>\n            {{/if}}\n        {{/each}}\n    </ul>\n{{/if}}\n","components/common/store-logo":"<a href=\"{{urls.home}}\" class=\"header-logo__link\" data-header-logo-link>\n    {{#if settings.store_logo.image}}\n        {{#if theme_settings.logo_size '===' 'original'}}\n        <img class=\"header-logo-image-unknown-size\"\n             src=\"{{getImage settings.store_logo.image 'logo_size'}}\"\n             alt=\"{{settings.store_logo.title}}\"\n             title=\"{{settings.store_logo.title}}\">\n        {{else}}\n        <div class=\"header-logo-image-container\">\n            <img class=\"header-logo-image\"\n                 src=\"{{getImage settings.store_logo.image 'logo_size'}}\"\n                 srcset=\"{{getImageSrcset1x2x settings.store_logo.image theme_settings.logo_size}}\"\n                 alt=\"{{settings.store_logo.title}}\"\n                 title=\"{{settings.store_logo.title}}\">\n        </div>\n        {{/if}}\n    {{else}}\n    <span class=\"header-logo-text\">{{settings.store_logo.title}}</span>\n    {{/if}}\n</a>\n"}
