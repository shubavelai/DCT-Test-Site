op_text2}}</a>              \r\n                            </div>\r\n                             <div class=\"top-bar-f\" aria-hidden=\"true\">\r\n                                    <a href=\"tel:1-866-297-0380\" title=\"Toll Free Number\" tabindex=\"-1\">Toll Free 1-866-297-0380</a>\r\n                                </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-4 col-lg-4 col-md-3 topbar-social\">\r\n                    <div class=\"top-rightside d-flex justify-content-end\">\r\n                        <div class=\"topbar-social-icon\">\r\n                           <ul class=\"navUser navUser-section d-flex\" style=\"list-style:none; margin:0; padding:0;\">\r\n                                        <li class=\"navUser-item\"> \r\n                                            <a href=\"https://www.decorativeceilingtiles.net/contact-us/\" class=\"navUser-action\">Contact Us</a>\r\n                                        </li>\r\n                                        <li class=\"navUser-item\" style=\"margin-left:15px;\">\r\n                                            <a href=\"https://www.decorativeceilingtiles.net/rewards-program/\" class=\"navUser-action\">Rewards Program</a>\r\n                                        </li>\r\n                            </ul>\r\n                        </div>\r\n                        <div class=\"top-currencies d-flex justify-content-end\">\r\n                            {{#or customer (unless settings.hide_price_from_guests)}}\r\n                                {{> components/common/currency-selector}}\r\n                            {{/or}}\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    {{/if}}\r\n{{/if}}\r\n<header class=\"header header-top\" role=\"banner\">\r\n    <a href=\"#\" class=\"mobileMenu-toggle\" data-mobile-menu-toggle=\"