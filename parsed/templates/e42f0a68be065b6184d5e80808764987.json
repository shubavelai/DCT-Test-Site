{"components/cms/image-with-text":"{{#if theme_settings.show-image-with-text}}\n<div class=\"section-spacing sectionLoad image-with-text-wrapper\">\n    <div class=\"container\">\n        <div class=\"image-with-text-main\">\n            <div class=\"image-text-row d-flex\">\n                <div class=\"imageWrapper\">\n                    <img class=\"img-fluid lazyload\" data-sizes=\"auto\" data-src=\"/product_images/uploaded_images/{{theme_settings.section_image}}\" width=\"1920px\" height=\"550px\" alt=\"banner\"/>\n                </div>\n                <div class=\"content_wrapper\">\n                    <div class=\"content-inner\">\n                        <h4>{{theme_settings.content_title}}</h4>\n                        <p>{{theme_settings.content}}{{theme_settings.content_1}}{{theme_settings.content_2}}</p>\n                        <a href=\"{{theme_settings.section_button_link}}\" class=\"button button--primary\">{{theme_settings.section_button_text}}</a>\n                    </div>\n                </div>\n            </div>\n            {{#if theme_settings.section_image1}}\n            <div class=\"image-text-row d-flex\">\n                <div class=\"imageWrapper\">\n                    <img class=\"img-fluid lazyload\" data-sizes=\"auto\" data-src=\"/product_images/uploaded_images/{{theme_settings.section_image1}}\" width=\"1920px\" height=\"550px\" alt=\"banner\"/>\n                </div>\n                <div class=\"content_wrapper\">\n                    <div class=\"content-inner\">\n                        <h4>{{theme_settings.content_title1}}</h4>\n                        <p>{{theme_settings.content1}}{{theme_settings.content_11}}{{theme_settings.content_21}}</p>\n                        <a href=\"{{theme_settings.section_button_link1}}\" class=\"button button--primary\">{{theme_settings.section_button_text1}}</a>\n                    </div>\n                </div>\n            </div>\n            {{/if}}\n        </div>\n    </div>\n</div>\n{{/if}}"}
